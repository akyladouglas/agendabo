# Copie para .env na raiz do monorepo (o .env real NUNCA é commitado).
# Validado por apps/api/src/config/env.validation.ts (zod) — mantenha os dois sincronizados.

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5174

# --- Banco / fila ---
DATABASE_URL=postgresql://agendabo:agendabo_dev@localhost:5434/agendabo?schema=public
REDIS_URL=redis://localhost:6381

# --- Auth ---
JWT_SECRET=troque…orio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Telegram (bot) ---
TELEGRAM_BOT_TOKEN=coloqu…aqui

# --- Resend (email de verificação) ---
RESEND_API_KEY=re_xxx…xxxx
RESEND_FROM=Agendabô <no-reply@seudominio.com>

# --- Anthropic (LLM) ---
# Cascata (ADR-008/llm.md): primario barato classifica/extrai; escala ao Sonnet so em
# falha de parse/timeout. Precos (USD/MTok entrada/saida): Haiku 4.5 = $1/$5, Sonnet 5.5 = $2/$10.
ANTHROPIC_API_KEY=sk-ant-…xxxx
LLM_MODEL_PRIMARY=claude-haiku-4-5-20251001
LLM_MODEL_ESCALATION=claude-sonnet-5-5
# Abaixo disso, a saida do LLM vira needs_review / o bot pergunta (LLM nunca decide sozinho)
MIN_CONFIDENCE_TO_ACCEPT=0.7
# Inatividade que descarta a sessao de conversa do bot na memoria (minutos)
BOT_SESSION_TTL_MINUTES=30
