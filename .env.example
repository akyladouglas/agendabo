# Copie para .env na raiz do monorepo (o .env real NUNCA é commitado).
# Validado por apps/api/src/config/env.validation.ts (zod) — mantenha os dois sincronizados.

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5174

# --- Banco / fila ---
DATABASE_URL=postgresql://agendabo:agendabo_dev@localhost:5434/agendabo?schema=public
REDIS_URL=redis://localhost:6381

# --- Auth ---
JWT_SECRET=troque…orio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Telegram (bot) ---
TELEGRAM_BOT_TOKEN=coloqu…aqui

# --- Resend (email de verificação) ---
# RESEND_FROM precisa usar domínio verificado no Resend (o raiz akyla-douglas.dev
# cobre qualquer subdomínio — ex.: agendabo.akyla-douglas.dev).
RESEND_API_KEY=re_xxx…xxxx
RESEND_FROM=Agendabô <no-reply@agendabo.akyla-douglas.dev>

# --- Anthropic (LLM) ---
# Cascata (ADR-008/llm.md): primario barato classifica/extrai; escala ao Sonnet so em
# falha de parse/timeout. Precos (USD/MTok entrada/saida): Haiku 4.5 = $1/$5, Sonnet 5.5 = $2/$10.
ANTHROPIC_API_KEY=sk-ant-…xxxx
LLM_MODEL_PRIMARY=claude-haiku-4-5-20251001
LLM_MODEL_ESCALATION=claude-sonnet-5-5
# Abaixo disso, a saida do LLM vira needs_review / o bot pergunta (LLM nunca decide sozinho)
MIN_CONFIDENCE_TO_ACCEPT=0.7
# Inatividade que descarta a sessao de conversa do bot na memoria (minutos)
BOT_SESSION_TTL_MINUTES=30

# --- Notificacoes (Fase 3: worker de lembretes + resumo diario) ---
# Tentativas de envio do worker antes de marcar a linha do outbox como `failed`
NOTIFY_MAX_ATTEMPTS=3
# Atraso maximo (minutos) aceito no disparo: Redis/API caiu e o instante passou mais
# que isso => lembrete obsoleto, a linha vai a `failed` (atraso_excedido)
NOTIFY_STALE_MINUTES=30

# --- Observabilidade (Fase 9: ADR-0016/0017) ---
# Tracker: SDK Sentry apontando para o GlitchTip SaaS (protocolo compativel).
# DSN ausente/commentado => processos ligam sem tracker (dev/testes sem rede).
# SENTRY_DSN=https://xxx@glitchtip.com/1
# Tracing de performance OFF ate producao (decisao humana 2026-10-09); ligar = mudar 1 env
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=0.1.0
# Salt do hash de telegramId em bot_events (>=16 chars; NAO reusar o JWT_SECRET)
EVENTS_HASH_SECRET=troque…orio
# Precos da ESTIMATIVA de custo do LLM em MICRO-USD por milhao de tokens (int —
# 1 USD = 1e6 micro) — obrigatorios, o sistema recusa estimar custo sem preco
# declarado. Haiku 4.5 = $1/$5 => 1000000/5000000; Sonnet 5.5 = $2/$10 => ...
LLM_PRICE_INPUT_USD_PER_MTOK=1000000
LLM_PRICE_OUTPUT_USD_PER_MTOK=5000000
# Web (build-time, apps/web/.env): VITE_SENTRY_DSN= (mesmo protocolo; vazio = sem tracker)
