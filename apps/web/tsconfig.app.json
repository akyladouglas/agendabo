{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@agendabo/contracts": ["../../packages/contracts/src/index.ts"],
      "@agendabo/schedule-core": ["../../packages/schedule-core/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    // packages consomados via alias de fonte (gotcha 3: sincronizar com vite.config.ts)
    "../../packages/contracts/src/**/*.ts",
    "../../packages/schedule-core/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules",
    "../../packages/*/src/**/*.spec.ts"
  ]
}
