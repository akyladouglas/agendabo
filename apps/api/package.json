{
  "name": "@agendabo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:bot": "nest build && node dist/bot-main.js",
    "dev:worker": "nest build && node dist/workers/notifications-worker.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run && jest --passWithNoTests",
    "lint": "eslint .",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "dotenv-cli -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv-cli -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv-cli -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@agendabo/contracts": "workspace:*",
    "@agendabo/schedule-core": "workspace:*",
    "@anthropic-ai/sdk": "^0.71.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^16.7.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
