// Modelagem minima do Agendabô (ver PROMPT.md + ia-docs/decisions).
// Datas em UTC; timezone por usuario (ADR-001). Conflito e regra deterministica
// em schedule-core, nunca decidida pelo LLM (ADR-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  confirmed
  needs_review
}

enum AppointmentOrigin {
  bot
  web
}

enum NotificationRuleType {
  none
  before_hours
  before_days
  countdown_3_2_1
}

enum NotificationOutboxStatus {
  pending
  sent
  failed
  /// Invalidada: compromisso editado/deletado, needs_review no disparo ou conta sem gate (Fase 3)
  cancelled
}

/// Tipo de disparo do outbox (Fase 3): lembrete de compromisso ou resumo diario (2.1)
enum NotificationKind {
  reminder
  daily_digest
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  /// Id numerico do Telegram (unico; null ate o fluxo de confirmacao permitir)
  telegramId       String?   @unique
  emailConfirmedAt DateTime?
  timezone         String    @default("America/Sao_Paulo")
  /// Hora do resumo diario no fuso do usuario, "HH:mm" (2.1)
  resumoDiarioHora String    @default("07:00")
  /// Nome como o bot deve chamar o usuario (decisao 7 da spec web; null = sem nome)
  name             String?
  /// Resumo diario ligado/desligado (Aberto #2 -> (a): desligado => nada e agendado)
  resumoDiarioAtivo Boolean  @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments  Appointment[]
  refreshTokens RefreshToken[]
  /// Linhas de outbox do usuario (digest diario nao tem compromisso — Fase 3)
  notificationOutbox NotificationOutbox[]

  @@map("users")
}

model Appointment {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  status    AppointmentStatus @default(confirmed)
  origin    AppointmentOrigin @default(web)
  /// Texto original dito no bot (auditoria da fila de revisao, 3.3)
  rawText   String?
  /// Por que caiu em revisao (parse falho / confianca baixa / conflito abortado)
  reviewReason String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationRules NotificationRule[]
  notificationOutbox NotificationOutbox[]

  @@index([userId, startsAt])
  @@index([status])
  @@map("appointments")
}

model NotificationRule {
  id   String               @id @default(uuid()) @db.Uuid
  type NotificationRuleType
  /// Horas/dias antes; null para none e countdown_3_2_1
  value Int?

  appointmentId String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("notification_rules")
}

/// Outbox pattern: cada disparo vira uma linha; worker BullMQ so consome o id.
/// A linha e a fonte de verdade da idempotencia (pending -> sent condicional).
model NotificationOutbox {
  id        String                   @id @default(uuid()) @db.Uuid
  firesAt   DateTime
  status    NotificationOutboxStatus @default(pending)
  /// reminder = lembrete de compromisso; daily_digest = resumo diario (2.1)
  kind      NotificationKind         @default(reminder)
  attempts  Int                      @default(0)
  lastError String?
  sentAt    DateTime?

  /// Digest nao tem compromisso: nullable desde a Fase 3
  appointmentId String?      @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Dono da notificacao (digest materializa sem compromisso; gate de conta no worker)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Regra que gerou este disparo (referencia informativa; payload vai no job).
  /// Null apenas no digest (nenhuma regra o gerou).
  ruleType NotificationRuleType?

  @@index([status, firesAt])
  /// Idempotencia do digest: 1 linha por (usuario, kind, dia). `@@unique` do Prisma
  /// nao expressa indice PARCIAL — a constraint real e o CREATE UNIQUE INDEX ...
  /// WHERE "appointmentId" IS NULL criado no SQL da migração fase3_outbox_kind.
  /// (Nao declarar @@unique aqui: `prisma migrate` tentaria recria-la como total.)
  @@index([userId, kind, firesAt])
  @@map("notification_outbox")
}

/// Tipo da prova de posse temporaria de email: codigo do cadastro ou token do
/// reset de senha ("Esqueci a senha" — reuso da tabela, decisao D1 da spec).
enum VerificationKind {
  email_verification
  password_reset
}

/// Codigo de verificacao de email (3.1.1 / ADR-002): 6 digitos, hash sha256.
/// Com `kind = password_reset` a mesma tabela guarda o token do magic link do
/// reset (64 hexchars, hash sha256, TTL 1h, quota 2/10min — spec esqueci-a-senha).
model VerificationCode {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  /// Hash sha256 do codigo ou do token de reset — o valor cru nunca e gravado.
  codeHash  String
  kind      VerificationKind @default(email_verification)
  expiresAt DateTime
  /// Timestamps de cada envio: comprimento no intervalo = quota (3/30min cadastro; 2/10min reset)
  sentAt    DateTime  @default(now())
  usedAt    DateTime?

  @@index([email, sentAt])
  /// Unicidade do token de reset: buscamos o linha por hash no reset, entao o
  /// hash precisa ser unico — MAS so entre linhas `password_reset` (codigos de
  /// 6 digitos tem espaco de 1e6 e colidem). `@@unique` do Prisma nao expressa
  /// indice PARCIAL; a constraint real e o CREATE UNIQUE INDEX ... WHERE criado
  /// no SQL da migracao password_reset_kind (mesma tecnica do digest do outbox).
  /// (Nao declarar @@unique aqui: `prisma migrate` tentaria recria-la como total.)
  @@index([codeHash])
  @@map("verification_codes")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
